{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoops-leaderboard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  // The retention sweep — see sweep() in src/index.js. Daily at 04:10 UTC;
  // it only ever clears expired personal data, so a missed run costs nothing
  // but a day, and running it twice does nothing the second time.
  "triggers": {
    "crons": ["10 4 * * *"]
  },

  // Which sites may call this API. Anything not listed gets a CORS refusal.
  // Localhost doesn't need naming — the Worker allows any local origin, whatever
  // port the dev server happened to pick. See isLocal() in src/index.js.
  "vars": {
    "ALLOWED_ORIGINS": "https://uvkush.github.io"
  },

  // database_id is filled in by ./setup.sh (or `npx wrangler d1 create hoops`)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoops",
      "database_id": "71b1a3a8-87ef-4b70-ba31-8e16389b290f"
    }
  ]
}
